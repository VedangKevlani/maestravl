// Maestravl Travel Intelligence Engine — data model
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// NOTE: enum-like status/type fields below are plain Strings holding one of
// a fixed set of values (documented alongside each field) rather than native
// Postgres enums, so adding a new status doesn't require a migration.
// Validity is enforced in the API layer via zod, and the canonical value
// lists live in lib/constants.ts.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac); rhel-openssl-3.0.x is what
  // Vercel's Node.js serverless functions run on — without it the query
  // engine binary Prisma ships is for the wrong OS and every DB call 500s.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase's pooled (PgBouncer, port 6543) connection — safe for
  // serverless functions, which can't hold many long-lived DB connections.
  url       = env("DATABASE_URL")
  // Supabase's direct (port 5432) connection — migrations need a real
  // connection, not a pooled one.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips       Trip[]
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 hex of the raw token — the raw token is only ever in the emailed link
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Trip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// UPCOMING | ACTIVE | COMPLETED | CANCELLED
  status    String   @default("UPCOMING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengers       Passenger[]
  segments         Segment[]
  documents        Document[]
  notificationLogs NotificationLog[]
  disruptions      Disruption[]
  agentRuns        AgentRun[]
}

model Passenger {
  id               String  @id @default(cuid())
  tripId           String
  trip             Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name             String
  isPrimary        Boolean @default(false)
  email            String?
  phone            String?
  emergencyContact String?

  segmentLinks SegmentPassenger[]
}

model Document {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String

  storedFilename   String // encrypted-at-rest filename on disk, never served publicly
  originalFilename String
  mimeType         String
  fileSize         Int
  /// PENDING | PROCESSING | COMPLETED | FAILED
  status           String    @default("PENDING")
  extractedRawText String?
  extractionError  String?
  uploadedAt       DateTime  @default(now())
  processedAt      DateTime?

  segments Segment[]
}

model Segment {
  id               String    @id @default(cuid())
  tripId           String
  trip             Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sourceDocumentId String?

  order         Int
  /// FLIGHT | TRAIN | BUS | TAXI | FERRY | CRUISE | BOAT | HELICOPTER | BICYCLE | RENTAL_CAR | WALKING | HOTEL | RESTAURANT | EXCURSION | OTHER
  transportType String
  /// SCHEDULED | BOARDING | DEPARTED | DELAYED | CANCELLED | ARRIVED | COMPLETED
  status        String @default("SCHEDULED")

  provider           String? // airline / train operator / hotel brand / restaurant name
  identifier         String? // flight/train/bus number
  confirmationNumber String?
  ticketNumber       String?

  departureLocation     String?
  departureLocationCode String?
  departureTerminal     String?
  departureGate         String?
  departureTime         DateTime?

  arrivalLocation     String?
  arrivalLocationCode String?
  arrivalTerminal     String?
  arrivalTime         DateTime?

  timezone    String?
  seat        String?
  cabin       String?
  travelClass String?
  currency    String?
  price       Float?
  notes       String?
  baggageInfo String?

  // JSON map of fieldName -> confidence score (0-100), set at extraction time,
  // cleared per-field once the user confirms/edits that field
  confidenceScores String? // JSON-encoded Record<string, number>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengerLinks     SegmentPassenger[]
  monitoring         MonitoringRecord?
  notificationLogs   NotificationLog[]
  disruptions        Disruption[]
  providerContacts   ProviderContact[]
  agentActions       AgentAction[]
  communications     Communication[]
  rescheduleRequests RescheduleRequest[]
  alternatives       Alternative[]
}

model SegmentPassenger {
  id           String    @id @default(cuid())
  segmentId    String
  segment      Segment   @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  passengerId  String
  passenger    Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  seat         String?
  ticketNumber String?

  @@unique([segmentId, passengerId])
}

model MonitoringRecord {
  id        String  @id @default(cuid())
  segmentId String  @unique
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  apiProvider   String? // which adapter/provider is responsible, e.g. "flight-adapter-v1"
  trackingKey   String? // provider-specific unique key for this segment
  /// NOT_CONFIGURED | ACTIVE | PAUSED | ERROR
  status        String    @default("NOT_CONFIGURED")
  lastCheckedAt DateTime?
  nextCheckAt   DateTime?
  lastKnownData String? // JSON-encoded snapshot of the last provider response
  confidence    Int? // 0-100, confidence in monitoring data freshness/accuracy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tracks how much of each flight-status provider's free-tier quota has been
// spent in the current window, so the monitoring rotator (see
// lib/monitoring/adapters/flightAdapter.ts) knows when to fall through to
// the next configured provider instead of running over quota. `resetAt` is
// the window boundary — refreshed from the provider's own rate-limit
// headers when it reports one (confirmed present on AeroDataBox, which
// resets on a rolling ~31-day window rather than calendar month), and
// otherwise defaulted to the next calendar-month boundary as a best guess.
model ProviderUsage {
  id        String   @id @default(cuid())
  provider  String   @unique // adapter id, e.g. "aviationstack-flight-v1"
  units     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

// One row per passenger notified about a monitored status change — the log
// that will later back "Maestravl rescheduled this on your behalf" history.
model NotificationLog {
  id        String  @id @default(cuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  segmentId String
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  /// MonitoringCheckStatus values, e.g. ON_TIME | DELAYED | CANCELLED | BOARDING | DEPARTED | ARRIVED
  previousStatus String?
  newStatus      String

  /// EMAIL | NONE (NONE = no recipient email on file, logged but not sent)
  channel        String  @default("EMAIL")
  recipientEmail String?
  recipientName  String?
  subject        String?
  success        Boolean @default(false)
  errorMessage   String?

  createdAt DateTime @default(now())
}

// --- Agentic recovery ---------------------------------------------------
// The models below back the autonomous recovery workflow: a monitoring
// status change becomes a Disruption, which starts an AgentRun, which
// executes a sequence of logged AgentActions (contacting providers,
// requesting reschedules, notifying the passenger) until resolved.
//
// There is deliberately no persisted "Dependency" table — which segments
// are downstream of a disrupted one is computed on demand from each
// segment's own order/time fields (see lib/dependency/graph.ts) rather than
// stored and kept in sync, since it's fully derivable and changes whenever
// a segment's time does.

// A detected change to a segment's status significant enough to threaten
// the rest of the trip. One MonitoringCheckResult status transition (see
// lib/monitoring/service.ts) that isn't just a benign update becomes one
// Disruption row, which is what an AgentRun is created to resolve.
model Disruption {
  id        String  @id @default(cuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  segmentId String
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  /// MonitoringCheckStatus values, e.g. ON_TIME | DELAYED | CANCELLED
  previousStatus String?
  newStatus      String

  previousDepartureTime DateTime?
  newDepartureTime      DateTime?
  delayMinutes          Int?

  /// LOW | MEDIUM | HIGH — see lib/dependency/graph.ts for how this is derived
  severity   String
  /// 0-100 — carried over from the monitoring provider's own confidence where it reports one
  confidence Int      @default(100)
  source     String // adapter id that detected it, e.g. "flight-adapter-v1"
  detectedAt DateTime @default(now())

  agentRuns AgentRun[]
}

// One resolution attempt for a Disruption. Persisted and resumable by
// design (see AgentAction below) so recovery survives a serverless cold
// start or the passenger closing their browser — the next cron tick or
// page load picks the run up by its `status` rather than relying on an
// in-memory process.
model AgentRun {
  id           String     @id @default(cuid())
  tripId       String
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  disruptionId String
  disruption   Disruption @relation(fields: [disruptionId], references: [id], onDelete: Cascade)

  /// DETECTED | ANALYZING | CONTACTING | WAITING_FOR_RESPONSE | RESCHEDULING |
  /// CONFIRMED | FAILED | ALTERNATIVE_FOUND | ACTION_REQUIRED | COMPLETED
  status      String    @default("DETECTED")
  summary     String? // short passenger-facing rollup, e.g. "Everything is handled."
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  actions            AgentAction[]
  communications     Communication[]
  rescheduleRequests RescheduleRequest[]
  alternatives       Alternative[]
}

// One step of an AgentRun's DETECT -> IMPACT -> CONTACT -> ... workflow.
// This is the audit trail from spec section 14 ("Agent Action Log") and the
// source of the passenger-facing timeline (section 11) — every autonomous
// action must produce one of these, in plain language, before or as it happens.
model AgentAction {
  id         String   @id @default(cuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  segmentId  String?
  segment    Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  /// ANALYZE_IMPACT | FIND_CONTACT | CONTACT_PROVIDER | REQUEST_RESCHEDULE |
  /// VERIFY | UPDATE_ITINERARY | NOTIFY_PASSENGER | SEARCH_ALTERNATIVES | ESCALATE
  type String

  /// LOW | MEDIUM | HIGH — the risk tier this action falls under (spec section 9)
  riskLevel String @default("LOW")
  /// PENDING | REQUIRES_APPROVAL | APPROVED | EXECUTED | FAILED | SKIPPED
  status    String @default("PENDING")

  description String // plain-language log line, e.g. "Hotel contact found from booking confirmation."
  detail      String? // JSON-encoded structured input/output, for debugging — never the only record of what happened
  approvedAt  DateTime?

  createdAt DateTime @default(now())
}

// Contact info for the provider tied to one segment. The itinerary/booking
// confirmation is always the source of truth (see docs/INTEGRATION.md) —
// `source` and `confidence` exist so a discovered-but-unverified contact
// (e.g. a provider website's general contact form) never gets treated the
// same as one lifted straight from the booking confirmation.
model ProviderContact {
  id        String  @id @default(cuid())
  segmentId String
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  /// EMAIL | SMS | WHATSAPP | WEB_FORM | PORTAL | OTHER
  channel String
  value   String // email address, phone number, or form/portal URL

  /// ITINERARY | BOOKING_CONFIRMATION | MANUAL | WEB_LOOKUP
  source     String
  confidence Int    @default(100)

  createdAt DateTime @default(now())

  communications Communication[]
}

// One message sent to (or received from) a provider on the passenger's
// behalf. Mirrors NotificationLog's shape deliberately, but scoped to
// provider-facing coordination rather than passenger status emails.
model Communication {
  id         String           @id @default(cuid())
  agentRunId String
  agentRun   AgentRun         @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  segmentId  String
  segment    Segment          @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    ProviderContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// OUTBOUND | INBOUND
  direction String
  /// EMAIL | SMS | WHATSAPP | WEB_FORM | PORTAL | OTHER
  channel   String

  subject String?
  content String // full message text — treat as PII, same as NotificationLog.recipientEmail

  /// DRAFTED | SENT | FAILED | DELIVERED | RESPONDED
  status       String    @default("DRAFTED")
  errorMessage String?
  sentAt       DateTime?
  respondedAt  DateTime?

  createdAt DateTime @default(now())
}

// A specific new-time ask sent to a provider for one segment. Distinct from
// Communication (the message envelope) so "what time did we ask for and did
// they say yes" can be queried without parsing message bodies.
model RescheduleRequest {
  id         String   @id @default(cuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  segmentId  String
  segment    Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  requestedTime DateTime
  reason        String?
  feeAmount     Float?
  currency      String?

  /// REQUESTED | CONFIRMED | REJECTED | NO_RESPONSE | CANCELLED
  status      String    @default("REQUESTED")
  respondedAt DateTime?

  createdAt DateTime @default(now())
}

// A ranked candidate resolution for a segment that couldn't simply be moved
// to the originally-requested time (spec section 8) — e.g. three different
// new pickup times for an airport transfer, ranked by how little they
// disrupt the rest of the trip.
model Alternative {
  id         String   @id @default(cuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  segmentId  String
  segment    Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  label            String // "Option A"
  proposedTime     DateTime?
  additionalCost   Float?
  currency         String?
  /// NONE | MINOR | MAJOR — impact on segments downstream of this one if selected
  downstreamImpact String
  rank             Int
  selected         Boolean   @default(false)

  createdAt DateTime @default(now())
}
