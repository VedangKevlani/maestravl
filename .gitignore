# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code session state
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# database & uploaded document storage (never committed)
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal
/storage/
e2e/output/
e2e/fixtures/*.png
e2e/fixtures/*.pdf

# tesseract.js language-model cache (downloaded on first OCR run)
*.traineddata
