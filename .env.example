# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # AUTH_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # FILE_ENCRYPTION_KEY
#
# DATABASE_URL / DIRECT_URL / SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY all
# come from a Supabase project (Settings -> Database, and Settings -> API):
#   DATABASE_URL  = the "Connection pooling" string (port 6543, ?pgbouncer=true)
#   DIRECT_URL    = the "Connection string" (direct, port 5432) — used for migrations
#   SUPABASE_URL  = Project URL
#   SUPABASE_SERVICE_ROLE_KEY = service_role secret key (server-only, never expose to the client)
#
# Also create a private Storage bucket named "documents" in the Supabase
# dashboard (Storage -> New bucket, "Public" toggled OFF).

DATABASE_URL=""
DIRECT_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
AUTH_SECRET=""
FILE_ENCRYPTION_KEY=""

# Resend API key — sends password-reset emails (see lib/email.ts).
# Get a free key at https://resend.com/api-keys (no card required).
RESEND_API_KEY=""
# Resend's shared sandbox sender works with no domain setup but only
# delivers to the email you signed up to Resend with. Swap in a verified
# domain address once you have one, e.g. "Maestravl <hello@maestravl.com>".
EMAIL_FROM="Maestravl <onboarding@resend.dev>"

# Authenticates scheduled calls to /api/cron/monitoring (see vercel.json and
# docs/INTEGRATION.md). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Optional — set any of these to enable live monitoring for that transport
# mode (see docs/INTEGRATION.md). Adapters report "not connected" until set.
# FLIGHT_MONITORING_API_KEY=   # AviationStack access_key — https://aviationstack.com/
# AERODATABOX_API_KEY=         # RapidAPI key, fallback flight provider once AviationStack's
#                               # free quota is spent for the month — https://rapidapi.com/aedbx-aedbx/api/aerodatabox

# Optional — enables live TRAIN and BUS monitoring (both share this one key
# — see lib/monitoring/adapters/transitland/) via Transitland
# (https://transit.land), a free-tier aggregator of GTFS/GTFS-realtime data
# for 55+ countries. Confirmed free tier: 10,000 REST queries/month,
# GTFS-Realtime included — sign up at
# https://www.transit.land/documentation/index#sign-up and verify the free
# tier doesn't ask for a card, same as every other "no card required" claim
# in this file. Even when set, a segment only gets checked once its
# operator name and train/bus number are filled in (Edit on the segment) —
# there's no station-code dictionary for trains/buses the way there is for
# airports, so auto-extracted segments won't match until a human fills
# those two fields in.
# TRANSITLAND_API_KEY=

# No free, self-serve rental-car or taxi status API was found as of
# 2026-08 (Avis/Booking.com/OpenNDC car-rental APIs and Uber/Lyft-style
# dispatch APIs are all partner/commercial-agreement-gated, not something a
# developer signs up for directly) — TAXI/RENTAL_CAR monitoring remains a
# stub regardless of this being set (lib/monitoring/adapters/taxiAdapter.ts
# only uses it to decide the wording of an honest "not connected" message,
# there's no real provider behind it). See docs/INTEGRATION.md.
# TAXI_DISPATCH_API_KEY=

# Ferry/cruise/boat monitoring (lib/monitoring/adapters/boatAdapter.ts) is
# also still a stub for the same reason as taxi/rental-car above — not in
# scope for this pass, only train/bus were researched and built out.
# MARITIME_MONITORING_API_KEY=

# Optional — enables a web-search fallback for provider contact discovery
# (lib/agents/contact.ts) when a segment's own booking confirmation/notes
# have no email/phone/website on file. Only used as a last resort, and
# only auto-emails what it finds if the result's domain plausibly matches
# the provider's name (see lib/agents/contactDiscovery.ts). Paid per
# request (reported ~$0.01, unconfirmed — check your MiniMax dashboard) —
# see https://platform.minimax.io/docs/guides/server-tools.
# MINIMAX_API_KEY=

# Optional — enables real detection of a provider's reply (rather than the
# manual "Heard back?" button — see app/components/TripRecoveryStatus.tsx)
# via Resend's Inbound feature (lib/agents/inboundReply.ts,
# app/api/webhooks/resend-inbound). Both must be set together — half-configured
# is the same as off. Setup, in the Resend dashboard:
#   1. Domain -> either use the free managed inbound address Resend gives
#      you (format: <something>@<id>.resend.app, no DNS needed) or add MX
#      records to a domain you own. Set RESEND_INBOUND_DOMAIN to whichever
#      one you use, e.g. "abc123.resend.app".
#   2. Webhooks -> Add Webhook -> point it at
#      https://<your-deployed-app>/api/webhooks/resend-inbound, subscribed
#      to the "email.received" event only.
#   3. Copy that webhook's signing secret into RESEND_WEBHOOK_SECRET.
# RESEND_INBOUND_DOMAIN=
# RESEND_WEBHOOK_SECRET=

# Optional — enables the voice assistant widget (app/components/VoiceWidget.tsx,
# app/api/trips/[id]/voice). Powers the reasoning/tool-calling loop that
# answers questions using real trip data (see lib/voice/agent.ts). Deliberately
# Gemini and not a paid provider: Gemini's free tier for Flash models is a
# genuinely ongoing, non-expiring free tier (rate-limited, no card required) —
# not a time-boxed trial credit. Get a key (no card needed) at
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional — enables a "Get an Uber there" link on a disrupted segment
# (lib/uber.ts, app/components/SegmentCard.tsx) that opens Uber's own
# app/website with pickup/dropoff prefilled — NOT a real booking. Maestravl
# has no payment handling anywhere and never touches money or an actual
# reservation here; the passenger uses their own Uber account. Free to get:
# Uber developer dashboard (https://developer.uber.com/dashboard/create-application)
# → create an app → this is the app's plain client_id, no business
# approval needed (approval is only required for privileged scopes like
# actually requesting a ride via the API, which this never calls).
# Deliberately NEXT_PUBLIC_ (not server-only like the keys above) — it runs
# client-side in SegmentCard.tsx, and unlike a real API key this isn't a
# secret: it's a visible query parameter in the link itself.
# NEXT_PUBLIC_UBER_CLIENT_ID=

# Optional — ElevenLabs key, a higher-quality voice for the assistant's
# replies. There is deliberately no third-party fallback if this is unset or
# fails (see lib/voice/tts.ts): the widget speaks the reply itself using the
# browser's own SpeechSynthesis instead, and speech-to-text likewise runs
# entirely client-side via the browser's SpeechRecognition (see
# app/components/VoiceWidget.tsx). Both a key and a voice id are required
# together — half-configured is the same as off. Without either, the voice
# assistant still fully works, just with a more robotic system voice instead
# of ElevenLabs — nothing beyond Gemini above is required to use it, and
# nothing in this pipeline has a billing path. Get a key and create/choose a
# voice at https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
